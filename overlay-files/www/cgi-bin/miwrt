#!/bin/sh
# Entry of the MiWRT app API. The API itself is /usr/share/miwrt/api.uc.
# Compiling it and its modules (130 kB of source) on every request costs a slow
# processor about half a second, so miwrt-hubd keeps a compiled copy in
# /tmp/miwrt. The copy is used only when root made it and it is newer than
# every source; in any other case the sources run, as they always did.
# Nothing from the request is passed on as an argument.
C=/tmp/miwrt/api.ucb
S=/usr/share/miwrt/api.uc
if [ -O "$C" ] && [ -s "$C" ]; then
	for f in "$S" /usr/share/ucode/miwrt/*.uc; do
		[ "$C" -nt "$f" ] || exec /usr/bin/ucode "$S"
	done
	exec /usr/bin/ucode "$C"
fi
exec /usr/bin/ucode "$S"
