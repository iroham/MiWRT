'use strict';

// The web interface's calls for the VPN, the router link and Tailscale (views miwrt-vpn/*).
// The work is in /usr/share/ucode/miwrt/tunnel.uc and tailscale.uc, the same code the app uses.

import * as tunnel from 'miwrt.tunnel';
import * as ts from 'miwrt.tailscale';
import * as hub from 'miwrt.hub';

// rpcd answers one call at a time: a call that waits for the app service's lock holds up every
// other call, so it waits 15 seconds at most and then says the router is busy
hub.set_lock_patience(15);

function result(r) {
	if (type(r) == 'string') return { error: r };
	return r ?? { ok: true };
}

function data(req) {
	let d = req.args?.data;
	return type(d) == 'object' ? d : {};
}

function call(fn) {
	return { args: { data: {} }, call: function(req) { return result(fn(data(req))); } };
}

return {
	'miwrt-vpn': {
		// rpcd answers one call at a time and the page waits 20 seconds at most: a check (up to 12 s)
		// and a subscription download (up to a minute) run in the background, the page asks again
		state: { args: { check: false }, call: function(req) { if (req.args?.check) tunnel.check_bg(); return tunnel.state(false); } },
		set: call(d => tunnel.set(d)),
		install: call(d => tunnel.engine_install()),
		remove: call(d => tunnel.engine_remove()),
		servers: call(d => tunnel.servers_action(d)),
		subscriptions: call(d => tunnel.subs_action({ ...d, background: true })),
		test: call(d => tunnel.test(d)),
		link_state: { call: function() { return tunnel.link_state(); } },
		link: call(d => tunnel.link_action(d)),
		relay: { call: function() { let r = tunnel.relay_config(); return r ? { config: r, image: 'ghcr.io/xtls/xray-core:26.11.9' } : { error: 'This router does not use a relay server.' }; } },
		ts_state: { call: function() { return ts.state(); } },
		ts_set: call(d => ts.set(d)),
		ts_install: call(d => ts.install()),
		ts_remove: call(d => ts.remove()),
		ts_login: call(d => ts.login(d)),
		ts_logout: call(d => ts.logout())
	}
};
