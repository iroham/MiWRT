{
	"luci-app-miwrt-vpn": {
		"description": "MiWRT VPN (Xray), router link and Tailscale",
		"read": {
			"ubus": {
				"miwrt-vpn": [ "state", "link_state", "ts_state" ],
				"luci-rpc": [ "getHostHints" ]
			}
		},
		"write": {
			"ubus": {
				"miwrt-vpn": [ "relay", "set", "install", "remove", "servers", "subscriptions", "test", "link", "ts_set", "ts_install", "ts_remove", "ts_login", "ts_logout" ]
			}
		}
	}
}
