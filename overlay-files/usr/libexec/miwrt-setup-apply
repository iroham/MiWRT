#!/bin/sh
# Runs a few seconds after the setup assistant saved its settings (see miwrt/setup.uc): restarts what
# changed, checks that an access point got an address from the main router (and puts the old settings
# back if it did not), then installs AdGuard Home if that was chosen.
# Progress for the wizard page: /tmp/miwrt/setup-job.json
#
# "resume" is how /etc/init.d/miwrt calls it at boot when the router was restarted (a power cut, say)
# before an access point had its address: the check goes on from there.

JOB=/tmp/miwrt/setup-job.json
BACKUP=/etc/miwrt/setup-backup.tar.gz
mkdir -p /tmp/miwrt

if [ "$1" = resume ]; then
	[ "$(uci -q get miwrt.setup.verify)" = 1 ] || exit 0
	mode=ap
	ap_proto=$(uci -q get network.lan.proto)
	adguard=false
else
	mode=$(jsonfilter -i "$JOB" -e '@.mode' 2>/dev/null)
	ap_proto=$(jsonfilter -i "$JOB" -e '@.ap_proto' 2>/dev/null)
	adguard=$(jsonfilter -i "$JOB" -e '@.adguard' 2>/dev/null)
	[ "$adguard" = true ] || adguard=false
fi
address=

put() {
	printf '{"state":"%s","step":"%s","mode":"%s","ap_proto":"%s","adguard":%s,"address":"%s","error":"%s","time":%s}\n' \
		"$1" "$2" "$mode" "$ap_proto" "$adguard" "$address" "$3" "$(date +%s)" > "$JOB.tmp" && mv "$JOB.tmp" "$JOB"
}

restart_all() {
	/etc/init.d/system reload >/dev/null 2>&1
	/etc/init.d/network reload >/dev/null 2>&1
	sleep 3
	/etc/init.d/firewall reload >/dev/null 2>&1
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	/etc/init.d/odhcpd restart >/dev/null 2>&1
}

verified() {
	uci -q delete miwrt.setup.verify && uci -q commit miwrt
}

if [ "$1" = resume ]; then
	put running address
else
	put running network
	restart_all
	logger -t miwrt-setup "settings from the setup assistant applied ($mode)"
fi

if [ "$mode" = ap ]; then
	put running address
	i=0
	while [ $i -lt 60 ]; do
		address=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
		[ -n "$address" ] && break
		i=$((i + 1)); sleep 2
	done
	if [ -z "$address" ]; then
		# no main router answered: back to the settings from before, so the router stays reachable
		put running restore
		if tar -xzf "$BACKUP" -C / 2>/dev/null; then
			uci -q set miwrt.setup.state=pending
			uci -q set miwrt.setup.retry=1   # the web interface opens the assistant again (it has a password now)
			uci -q delete miwrt.setup.verify
			uci -q commit miwrt
			rm -f /tmp/luci-indexcache*
			restart_all
			logger -t miwrt-setup "access point got no address from the main router, previous settings restored"
			put failed address "No main router gave this router an address. Check that the cable from your main router is in the WAN port. The settings from before are back."
		else
			# without the copy there is nothing to go back to; the check runs again at the next start
			logger -t miwrt-setup "access point got no address from the main router, and the saved settings could not be read"
			put failed address "No main router gave this router an address, and the settings from before could not be put back. Connect the cable from your main router to the WAN port and restart the router."
		fi
		exit 1
	fi
	verified
fi

# the smart-home discovery relays start with the service, and only where an IoT network exists
if [ "$1" != resume ] && [ -d /sys/class/net/br-iot ]; then
	/etc/init.d/miwrt restart >/dev/null 2>&1
fi

if [ "$adguard" = true ]; then
	put running adguard
	/usr/libexec/miwrt-adguard install /tmp/miwrt/adguard-pass
fi

put done done
