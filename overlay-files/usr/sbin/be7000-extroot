#!/bin/sh
# Move /overlay onto an external disk (extroot).
#
# Everything the router keeps between reboots lives in /overlay: installed
# packages, settings, lists. On this board the built-in space for it is small,
# so a USB disk is the way to get room.
#
# Usage:
#   be7000-extroot status
#   be7000-extroot list
#   be7000-extroot use <device> [--yes] [--reboot]
#   be7000-extroot revert [--yes] [--reboot]

set -e

LABEL=be7000_overlay
MNT=/tmp/extroot.$$

. /lib/functions/be7000-factory-reset-guard.sh
. "${BE7000_FSTAB_LIB:-/lib/functions/be7000-fstab.sh}"

die() { echo "$*" >&2; exit 1; }

# fstools reads the extroot entry from the fstab in the slot's own rootfs_data
# volume, one level only. On this board /overlay normally lives on the shared
# volume on mtd28 (bigoverlay), so a plain `uci commit fstab` lands there and
# fstools never sees it. The entry has to go into rootfs_data as well.
rootfs_data_dev() {
	local n
	for n in /sys/class/ubi/ubi*_*/name; do
		[ -e "$n" ] || continue
		[ "$(cat "$n")" = rootfs_data ] && { echo "/dev/$(basename "$(dirname "$n")")"; return 0; }
	done
	return 1
}

# The shared settings volume on mtd28 (bigoverlay): stock's "cfg".
bigoverlay_dev() {
	local n
	for n in /sys/class/ubi/ubi1_*/name; do
		[ -e "$n" ] || continue
		[ "$(cat "$n")" = cfg ] && { echo "/dev/$(basename "$(dirname "$n")")"; return 0; }
	done
	return 1
}

# Run "uci batch" with stdin on the fstab of the overlay volume <dev>, then the
# check "$2 <config dir> ..." (see be7000_fstab_batch: a missing fstab is made
# first, and a change the check does not find in the file is taken back and
# counts as failed). When /overlay is that volume, it is the live /etc/config.
# $1 volume, $2 check function ("" for none), then its arguments
with_volume_config() {
	local dev="$1" dir mnt="" rc=0
	shift
	if [ "$dev" = "$(current_overlay_device)" ]; then
		be7000_fstab_batch /etc/config "$@"
		return $?
	fi
	dir="$(mount | awk -v d="$dev" '$1 == d { print $3; exit }')"
	if [ -z "$dir" ]; then
		mnt=/tmp/extroot-vol.$$
		mkdir -p "$mnt"
		mount -t ubifs "$dev" "$mnt" || { rmdir "$mnt"; echo "cannot mount $dev" >&2; return 1; }
		dir="$mnt"
	fi
	if [ "$1" = extroot_gone ] && [ ! -e "$dir/upper/etc/config/fstab" ]; then
		# nothing to take out, and no reason to make the file (or an upper/
		# directory inside a volume that is not used as an overlay)
		:
	else
		be7000_fstab_batch "$dir/upper/etc/config" "$@" || rc=1
	fi
	sync
	[ -n "$mnt" ] && { umount "$mnt"; rmdir "$mnt"; }
	return $rc
}

with_rootfs_data() {
	local dev
	be7000_factory_reset_pending && { echo "factory reset is pending" >&2; return 1; }
	dev="$(rootfs_data_dev)" || { echo "rootfs_data volume not found" >&2; return 1; }
	with_volume_config "$dev" "$@"
}

# The extroot entry for the disk with UUID $1, as "uci batch" input. USB disks
# need a few seconds to show up in preinit, hence delay_root: 15 seconds, or
# the longer wait someone has set in the live settings.
# $1 UUID, $2 delay_root of the live settings, $3 enabled (1 when left out)
extroot_batch() {
	local wait="${2:-0}"
	[ "$wait" -ge 15 ] 2>/dev/null || wait=15
	cat <<-EOT
		set fstab.extroot=mount
		set fstab.extroot.target='/overlay'
		set fstab.extroot.uuid='$1'
		set fstab.extroot.fstype='ext4'
		set fstab.extroot.options='rw,noatime'
		set fstab.extroot.enabled='${3:-1}'
		set fstab.@global[0].delay_root='$wait'
		commit fstab
	EOT
}

# delay_root as the live settings have it
live_delay() { be7000_fstab_get /etc/config '@global[0].delay_root' || true; }

# The file in config dir $1 names the disk with UUID $2 as /overlay.
# $3 the value "enabled" has to have, 1 when left out
extroot_written() {
	local d
	be7000_fstab_has "$1" extroot target /overlay uuid "$2" fstype ext4 enabled "${3:-1}" || return 1
	d="$(be7000_fstab_get "$1" '@global[0].delay_root')" || return 1
	[ "${d:-0}" -ge 15 ] 2>/dev/null
}

extroot_gone() { be7000_fstab_lacks "$1" extroot; }

current_overlay_device() {
	mount | awk '$3 == "/overlay" { print $1; exit }'
}

# In use: mounted, or an active swap partition (swap does not show in mount).
dev_in_use() {
	mount | grep -q "^$1 " && return 0
	grep -q "^$1 " /proc/swaps 2>/dev/null && return 0
	return 1
}

# A whole disk is busy when any of its partitions is in use.
children_busy() {
	local d
	case "$1" in
	/dev/sd[a-z]) ;;
	/dev/mmcblk[0-9]) ;;
	*) return 1 ;;
	esac
	for d in "$1"[0-9]* "$1"p[0-9]*; do
		[ -b "$d" ] || continue
		dev_in_use "$d" && return 0
	done
	return 1
}


# A partition whose whole disk is in use is not safe to touch: after the disk
# was re-partitioned the kernel can still expose stale partition nodes that now
# overlap a live filesystem, and formatting one of those eats the disk.
parent_busy() {
	local dev="$1" parent
	case "$dev" in
	/dev/sd[a-z][0-9]*) parent="$(echo "$dev" | sed 's/[0-9]*$//')" ;;
	/dev/mmcblk[0-9]p[0-9]*) parent="$(echo "$dev" | sed 's/p[0-9]*$//')" ;;
	*) return 1 ;;
	esac
	dev_in_use "$parent" && return 0
	return 1
}

cmd_status() {
	local dev
	dev="$(current_overlay_device)"
	echo "/overlay is on: ${dev:-unknown}"
	df -h /overlay | tail -1
	echo
	echo "configured in fstab:"
	if uci -q get fstab.extroot >/dev/null; then
		local where
		where="$(uci -q get fstab.extroot.device || true)"
		[ -n "$where" ] || where="UUID $(uci -q get fstab.extroot.uuid)"
		echo "  $where"
		echo "  enabled $(uci -q get fstab.extroot.enabled)"
	else
		echo "  no extroot entry"
	fi
}

# A candidate is a whole disk or partition that is not currently mounted and is
# not where the running system lives.
cmd_list() {
	local found=0 d name size model
	for d in /dev/sd[a-z] /dev/sd[a-z][0-9]* /dev/mmcblk[0-9]p[0-9]*; do
		[ -b "$d" ] || continue
		name="$(basename "$d")"
		size="$(awk -v n="$name" '$4 == n { printf "%.1f GB", $3/1024/1024 }' /proc/partitions)"
		model=""
		[ -r "/sys/class/block/$name/device/model" ] && model="$(cat "/sys/class/block/$name/device/model")"
		if dev_in_use "$d"; then
			echo "$d  ${size:-?}  $model  (in use, skipped)"
		elif children_busy "$d"; then
			echo "$d  ${size:-?}  $model  (partitions in use, skipped)"
		elif parent_busy "$d"; then
			echo "$d  ${size:-?}  $model  (whole disk in use, skipped)"
		else
			echo "$d  ${size:-?}  $model"
			found=1
		fi
	done
	[ "$found" = 1 ] || echo "no usable disks found; plug one into the USB port and try again"
}

# Same survey as cmd_list, as JSON, for the LuCI page.
cmd_list_json() {
	local first=1 d name size model mounted
	printf '['
	for d in /dev/sd[a-z] /dev/sd[a-z][0-9]* /dev/mmcblk[0-9]p[0-9]*; do
		[ -b "$d" ] || continue
		name="$(basename "$d")"
		size="$(awk -v n="$name" '$4 == n { printf "%.0f", $3/1024 }' /proc/partitions)"
		model=""
		[ -r "/sys/class/block/$name/device/model" ] && model="$(tr -d '\r' < "/sys/class/block/$name/device/model" | sed 's/[[:space:]]*$//' | sed 's/"/\\"/g')"
		mounted=false
		dev_in_use "$d" && mounted=true
		children_busy "$d" && mounted=true
		parent_busy "$d" && mounted=true
		[ $first = 1 ] || printf ','
		first=0
		printf '{"device":"%s","size_mb":%s,"model":"%s","mounted":%s}' "$d" "${size:-0}" "$model" "$mounted"
	done
	printf ']\n'
}

cmd_status_json() {
	local dev total avail uuid enabled
	dev="$(current_overlay_device)"
	set -- $(df -k /overlay | tail -1)
	total="$2"; avail="$4"
	uuid="$(uci -q get fstab.extroot.uuid || true)"
	enabled="$(uci -q get fstab.extroot.enabled || true)"
	[ -n "$enabled" ] || enabled=""
	printf '{"device":"%s","total_kb":%s,"available_kb":%s,"extroot_uuid":"%s","extroot_enabled":"%s"}\n' \
		"${dev:-}" "${total:-0}" "${avail:-0}" "$uuid" "$enabled"
}

cmd_use() {
	local dev="$1" yes="$2" do_reboot="$3" uuid before
	be7000_factory_reset_pending && die "factory reset is pending; extroot changes are deferred"
	[ -n "$dev" ] || die "usage: be7000-extroot use <device> [--yes] [--reboot]"
	[ -b "$dev" ] || die "$dev is not a block device"
	dev_in_use "$dev" && die "$dev is mounted or used as swap, free it first"
	children_busy "$dev" && die "partitions of $dev are mounted or used as swap, a whole disk in use cannot be formatted"
	parent_busy "$dev" && die "the whole disk this partition sits on is mounted, so this node may be stale; unmount it first"
	case "$dev" in
	/dev/ubi*|/dev/mtd*) die "$dev is internal flash, not an external disk" ;;
	esac
	[ "$dev" = "$(current_overlay_device)" ] && die "$dev already carries /overlay"

	if [ "$yes" != 1 ]; then
		echo "This erases everything on $dev and moves /overlay onto it."
		echo "Re-run with --yes to go ahead."
		exit 1
	fi

	command -v mkfs.ext4 >/dev/null || die "mkfs.ext4 is missing"

	# Before anything is erased: the two files this has to write exist and
	# take a change. A router without /etc/config/fstab used to get as far as
	# "Done" here with nothing written, and came back up on internal storage.
	be7000_fstab_ensure /etc/config || die "cannot create /etc/config/fstab, nothing was changed"
	with_rootfs_data "" </dev/null || die "cannot prepare fstab in rootfs_data, nothing was changed"
	before=/tmp/extroot-fstab-before.$$
	cp /etc/config/fstab "$before" || die "cannot keep a copy of /etc/config/fstab, nothing was changed"

	echo "Formatting $dev"
	mkfs.ext4 -q -F -L "$LABEL" "$dev"

	mkdir -p "$MNT"
	mount "$dev" "$MNT" || { rm -f "$before"; rmdir "$MNT" 2>/dev/null || true; die "cannot mount $dev after formatting it; the router's settings were not changed"; }

	# from the whole list first: asked about one device, block answers for
	# some kinds of device only
	uuid="$(block info 2>/dev/null | awk -v d="$dev:" '$1 == d {
		if (match($0, / UUID="[^"]*"/)) print substr($0, RSTART + 7, RLENGTH - 8)
		exit
	}')"
	[ -n "$uuid" ] || uuid="$(block info "$dev" 2>/dev/null | sed -n 's/.*UUID="\([^"]*\)".*/\1/p' | head -n 1)"
	[ -n "$uuid" ] || use_failed "$before" "cannot read the UUID of $dev"

	# Settings first, so the copy on the disk already has its fstab entry.
	extroot_batch "$uuid" "$(live_delay)" |
		be7000_fstab_batch /etc/config extroot_written "$uuid" ||
		use_failed "$before" "the extroot entry did not reach /etc/config/fstab"

	echo "Copying the current overlay across"
	# /overlay holds upper/ and work/; copy the contents, not the mount point.
	cp -a /overlay/. "$MNT"/ 2>/dev/null || true
	mkdir -p "$MNT/upper" "$MNT/work"
	# On the disk bigoverlay must be off, otherwise its boot script reboots to
	# "switch /overlay back" to mtd28. Only there: the internal settings keep
	# whatever the user chose.
	mkdir -p "$MNT/upper/etc/config"
	[ -f "$MNT/upper/etc/config/bigoverlay" ] || cp /rom/etc/config/bigoverlay "$MNT/upper/etc/config/" 2>/dev/null || true
	uci -q -c "$MNT/upper/etc/config" set bigoverlay.main.enabled='0' && uci -q -c "$MNT/upper/etc/config" commit bigoverlay || true
	sync
	# the copy is what the router runs from after the reboot: it has to name
	# the disk too, and to keep bigoverlay off
	extroot_written "$MNT/upper/etc/config" "$uuid" ||
		use_failed "$before" "the copy of the settings on $dev has no extroot entry (is the disk full?)"
	[ "$(uci -q -c "$MNT/upper/etc/config" get bigoverlay.main.enabled || true)" = 0 ] ||
		use_failed "$before" "could not switch bigoverlay off in the copy of the settings on $dev"
	umount "$MNT"
	rmdir "$MNT"

	echo "Pointing /overlay at $dev (UUID $uuid)"
	# This is the fstab fstools actually reads at boot. The extroot entry sorts
	# before bigoverlay (UUID against "ubi1_*"), so it wins while the disk is
	# there; without the disk the router boots on the slot's small overlay.
	extroot_batch "$uuid" "$(live_delay)" | with_rootfs_data extroot_written "$uuid" ||
		use_failed "$before" "could not write the extroot entry into rootfs_data"
	rm -f "$before"

	echo "Done. The change takes effect on the next boot."
	if [ "$do_reboot" = 1 ]; then sync; reboot; fi
}

# A step of "use" after the format did not hold: the settings go back to what
# they were, so the next boot does not land on a disk that was only half set
# up, and the reason is said.
# $1 copy of /etc/config/fstab from before, $2 reason
use_failed() {
	umount "$MNT" 2>/dev/null || true
	rmdir "$MNT" 2>/dev/null || true
	if [ -f "$1" ]; then
		uci -q revert fstab 2>/dev/null || true
		cat "$1" > /etc/config/fstab 2>/dev/null || true
		rm -f "$1"
		sync
	fi
	die "$2. The disk was formatted, but the router's settings are as they were before and /overlay stays where it is."
}

cmd_revert() {
	local yes="$1" do_reboot="$2"
	be7000_factory_reset_pending && die "factory reset is pending; extroot changes are deferred"
	uci -q get fstab.extroot >/dev/null || die "no extroot entry to remove"
	if [ "$yes" != 1 ]; then
		echo "This returns /overlay to internal flash. Anything stored on the disk stays there but stops being used."
		echo "Re-run with --yes to go ahead."
		exit 1
	fi
	# rootfs_data first: that is the copy fstools reads, and when it cannot be
	# changed the live settings stay as they are too, so the two do not differ
	printf 'delete fstab.extroot\ncommit fstab\n' | with_rootfs_data extroot_gone ||
		die "could not remove the extroot entry from rootfs_data, nothing was changed"
	printf 'delete fstab.extroot\ncommit fstab\n' | be7000_fstab_batch /etc/config extroot_gone ||
		die "could not remove the extroot entry from /etc/config/fstab"
	# use also wrote the entry into the shared volume on mtd28; when reverting
	# from the disk that volume is not /etc, so clean it here too.
	local vol
	if vol="$(bigoverlay_dev)"; then
		printf 'delete fstab.extroot\ncommit fstab\n' | with_volume_config "$vol" extroot_gone ||
			echo "note: could not clean the settings on $vol" >&2
	fi
	echo "Removed. The change takes effect on the next boot."
	if [ "$do_reboot" = 1 ]; then sync; reboot; fi
}

# The disk the settings name is plugged in but is not /overlay yet. After a
# firmware update that is the boot before the router reboots onto it, and the
# only moment its upper/ can be changed: files of a mounted overlay must not
# be moved from under it. So do here what the preinit hooks do for the
# built-in volumes before USB is up (78_be7000_overlay_refresh,
# 79_be7000_stale_modules): when the settings on the disk last ran with
# another image, move its old copies of image files to .be7000-replaced/ on
# the disk, let the image's first-boot scripts run again, and set modules of
# another kernel aside. be7000-romsync does the rest once the disk is /overlay.
# A disk whose settings already ran with this image is left untouched.
# $1 UUID of the disk
prepare_disk() {
	local uuid="$1" dev mnt lib="${BE7000_IMAGE_LIB:-/lib/functions/be7000-image.sh}"
	[ -n "$uuid" ] && [ -r "$lib" ] || return 0
	dev="$(block info 2>/dev/null | awk -F: -v u="$uuid" 'index(tolower($0), "uuid=\"" tolower(u) "\"") { print $1; exit }')"
	[ -n "$dev" ] || return 0
	dev_in_use "$dev" && return 0
	mnt="${BE7000_RESET_TMP:-/tmp}/extroot-prepare.$$"
	mkdir -p "$mnt" || return 0
	mount -o rw,noatime "$dev" "$mnt" 2>/dev/null || { rmdir "$mnt"; return 0; }
	. "$lib"
	BE7000_IMAGE_ROOT="${BE7000_IMAGE_ROM:-/rom}"
	be7000_refresh_volume "$mnt" || true
	be7000_stale_modules_volume "$mnt" || true
	sync
	umount "$mnt" 2>/dev/null && rmdir "$mnt" 2>/dev/null || true
	return 0
}

# Boot check, from /etc/init.d/be7000-extroot. A sysupgrade creates the
# slot's rootfs_data anew, and with it goes the extroot entry fstools reads:
# the router then comes up on the shared volume and the disk sits unused,
# although the live settings still name it. Put the entry back from the live
# settings, and reboot once onto the disk if it is plugged in. When the entry
# is already there nothing changes, so this cannot loop.
cmd_boot_sync() {
	local rd cur mnt dir="" uuid en rd_uuid rd_en changed=0 marker bigdev bigen extuuid exten useful _w
	if be7000_factory_reset_pending; then
		logger -t be7000-extroot "factory reset pending, leaving extroot quarantined"
		return 0
	fi
	rd="$(rootfs_data_dev)" || return 0
	cur="$(current_overlay_device)"
	# On the first boot after sysupgrade the restored fstab arrives only after
	# fstools has already selected the new slot's small rootfs_data. Reboot once
	# so the early boot can read that fstab and select the shared cfg volume.
	# The marker belongs to this slot's rootfs_data and prevents a reboot loop
	# if the configured volume still cannot be mounted.
	if [ "$cur" = "$rd" ]; then
		marker=/etc/.be7000_overlay_retry
		bigdev="$(uci -q get fstab.bigoverlay.device || true)"
		bigen="$(uci -q get fstab.bigoverlay.enabled || true)"
		# A disk named as extroot counts first: fstools prefers it, so the
		# reboot gets the router onto the disk whatever bigoverlay's own
		# switch says (a router that lives on a USB disk keeps bigoverlay off).
		# The settings volume alone counts only while bigoverlay is switched
		# on and has not failed: with it off or a failed migration, there is
		# no overlay there to use.
		extuuid="$(uci -q get fstab.extroot.uuid || true)"
		exten="$(uci -q get fstab.extroot.enabled || true)"
		useful=0
		if [ "${exten:-0}" = 1 ] && [ -n "$extuuid" ]; then
			# the USB disk may still be coming up
			for _w in 1 2 3 4 5 6 7 8; do
				block info 2>/dev/null | grep -qi "$extuuid" && { useful=1; break; }
				sleep 2
			done
			# the next boot mounts it as /overlay: get it ready for this image
			if [ $useful = 1 ]; then prepare_disk "$extuuid"; fi
		fi
		# the spare slot given over to /overlay, attached as ubi2 in preinit
		if [ $useful = 0 ] && [ "$(uci -q get fstab.slotstorage.enabled)" = 1 ] &&
			[ -e "$(uci -q get fstab.slotstorage.device)" ]; then
			useful=1
		fi
		if [ $useful = 0 ] && [ "$(uci -q get bigoverlay.main.enabled)" = 1 ] && [ ! -e /etc/bigoverlay.failed ] &&
			[ "${bigen:-0}" = 1 ] && [ -n "$bigdev" ] && [ -e "$bigdev" ]; then
			useful=1
		fi
		if [ $useful = 1 ] && [ ! -e "$marker" ]; then
			touch "$marker"
			sync
			logger -t be7000-extroot "fstab was restored after early boot, rebooting once to use the configured overlay"
			. /lib/functions/be7000-bootcount.sh && be7000_bootcount_clear
			( sleep 5; reboot ) </dev/null >/dev/null 2>&1 &
		fi
		return 0
	fi

	uuid="$(uci -q get fstab.extroot.uuid || true)"
	en="$(uci -q get fstab.extroot.enabled || true)"

	dir="$(mount | awk -v d="$rd" '$1 == d { print $3; exit }')"
	if [ -z "$dir" ]; then
		mnt=/tmp/extroot-sync.$$
		mkdir -p "$mnt"
		mount -t ubifs "$rd" "$mnt" 2>/dev/null || { rmdir "$mnt"; return 0; }
		dir="$mnt"
	fi
	rd_uuid="$(uci -q -c "$dir/upper/etc/config" get fstab.extroot.uuid || true)"
	rd_en="$(uci -q -c "$dir/upper/etc/config" get fstab.extroot.enabled || true)"

	if [ -z "$uuid" ]; then
		if [ -n "$rd_uuid" ]; then
			uci -q -c "$dir/upper/etc/config" delete fstab.extroot && uci -q -c "$dir/upper/etc/config" commit fstab || true
			logger -t be7000-extroot "extroot is off in the settings, removed it from rootfs_data too"
		fi
	elif [ "$uuid" != "$rd_uuid" ] || [ "$en" != "$rd_en" ]; then
		# a fresh fstab is made with its global section, which holds
		# delay_root. Only an entry that is found in the file afterwards
		# counts: the reboot below is for an entry that is there, and one
		# that was not written would ask for the same reboot on every boot.
		if extroot_batch "$uuid" "$(live_delay)" "${en:-1}" |
			be7000_fstab_batch "$dir/upper/etc/config" extroot_written "$uuid" "${en:-1}"; then
			logger -t be7000-extroot "rootfs_data had no extroot entry for UUID $uuid (after an upgrade), put it back"
			changed=1
		else
			logger -t be7000-extroot "could not put the extroot entry for UUID $uuid back into rootfs_data, staying on this overlay"
		fi
	fi
	sync
	[ -n "$mnt" ] && { umount "$mnt"; rmdir "$mnt"; }

	if [ "$changed" = 1 ] && [ "${en:-1}" = 1 ] && block info 2>/dev/null | grep -q "UUID=\"$uuid\""; then
		prepare_disk "$uuid"
		logger -t be7000-extroot "the disk is here, rebooting once to put /overlay on it"
		. /lib/functions/be7000-bootcount.sh && be7000_bootcount_clear
		( sleep 5; reboot ) </dev/null >/dev/null 2>&1 &
	fi
	return 0
}

YES=0
REBOOT=0
ACTION="$1"
[ $# -gt 0 ] && shift
DEV=""
for a in "$@"; do
	case "$a" in
	--yes) YES=1 ;;
	--reboot) REBOOT=1 ;;
	--json) ;;
	*) DEV="$a" ;;
	esac
done

JSON=0
for a in "$@"; do [ "$a" = "--json" ] && JSON=1; done

case "$ACTION" in
status) [ $JSON = 1 ] && cmd_status_json || cmd_status ;;
list)   [ $JSON = 1 ] && cmd_list_json || cmd_list ;;
use)    cmd_use "$DEV" "$YES" "$REBOOT" ;;
revert) cmd_revert "$YES" "$REBOOT" ;;
boot-sync) cmd_boot_sync ;;
*)
	echo "usage: be7000-extroot {status|list|use <device> [--yes] [--reboot]|revert [--yes] [--reboot]}"
	exit 1
	;;
esac
