#!/bin/sh /etc/rc.common
# State triggers for the LEDs, see /usr/libexec/be7000-leds. Starts after the
# led service (START=96) so its configuration is already applied, and again
# whenever the LED configuration changes.
START=97
USE_PROCD=1

# is there an LED for the watcher to drive
state_led() {
	local trig
	config_get trig "$1" trigger
	[ "$trig" = be7000-state ] && STATE_LED=1
	return 0
}

start_service() {
	# MiWRT leaves the amber network LED as it is. It can follow 2.4 GHz
	# traffic here; to get that, run /usr/libexec/be7000-leds seed once.

	# The watcher runs only while an LED uses the State trigger. This is
	# called again at every change of the LED configuration: the first such
	# LED starts the watcher, and without one procd stops it. On its way out
	# the watcher puts out the LEDs it no longer drives.
	STATE_LED=""
	config_load system
	config_foreach state_led led
	[ -n "$STATE_LED" ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/be7000-leds watch
	procd_set_param respawn 3600 10 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger system
}
