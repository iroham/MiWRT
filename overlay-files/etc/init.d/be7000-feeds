#!/bin/sh /etc/rc.common
# Keep the feeds pointed at what the running image was built from.
#
# Userspace packages are published per OpenWrt base (feed/<base>/<arch>/...),
# because packages built on one base do not fit another one: the base is the
# FEED= line of /rom/etc/miwrt-release.
#
# Modules are published per kernel config hash (vermagic), under
# feed/targets/<target>/<hash>/packages/. The image is built with the right
# hash in customfeeds.list, but that file is a conffile: sysupgrade carries the
# old one over, and with the overlay on its own partition it survives anyway.
# An upgraded router would keep asking for modules of the kernel it no longer
# runs. So fix the line on every boot from what the ROM says (never from apk's
# installed database: that lives in the overlay too and can describe the
# previous image).
START=97

LIST=/etc/apk/repositories.d/customfeeds.list

rom_kernel_hash() {
	sed -n 's/^KERNEL=//p' /rom/etc/miwrt-release 2>/dev/null | head -1
}

# customfeeds.list is a conffile, so a router upgraded from an older image keeps
# its old list. Lines the new image ships that are missing there are appended
# (the ROM's copy already carries the right base and kernel hash).
add_new_feeds() {
	local l
	[ -r /rom$LIST ] || return 0
	grep -E '^https?://' /rom$LIST | while read -r l; do
		grep -qxF "$l" "$LIST" || { echo "$l" >> "$LIST"; logger -t be7000-feeds "added feed $l"; }
	done
}

start() {
	[ -f "$LIST" ] || return 0
	local base
	base=$(sed -n 's/^FEED=//p' /rom/etc/miwrt-release 2>/dev/null | head -1)
	if [ -n "$base" ] && ! grep -q "feed/$base/aarch64_cortex-a73/" "$LIST"; then
		sed -i -E "s|feed/[A-Za-z0-9._-]+/aarch64_cortex-a73/|feed/$base/aarch64_cortex-a73/|" "$LIST"
		logger -t be7000-feeds "package feeds now feed/$base"
	fi
	local hash
	hash=$(rom_kernel_hash)
	if [ -n "$hash" ]; then
		local want="feed/targets/qualcommbe/ipq95xx/$hash/packages/packages.adb"
		grep -q "$want" "$LIST" || {
			# the hash of the previous image
			sed -i -E "s|feed/targets/qualcommbe/ipq95xx/[0-9a-f]{32}/packages/packages\.adb|$want|" "$LIST"
			logger -t be7000-feeds "kernel module feed now $want"
		}
	fi
	add_new_feeds
}
