#!/bin/sh /etc/rc.common
# Bring Wi-Fi up on a fresh install, with a password.
#
# The port generates both networks without a password and disabled. A board
# whose LAN never answers would then have no way in at all: once the system
# has booted and confirmed itself, the bootloader will not fall back to stock
# any more. So a fresh install gets a known network (see README and the
# instruction) as a second door.
#
# Fresh install or not? Not by whether /etc/config/wireless exists: the Wi-Fi
# drivers come up asynchronously and hotplug generates that file around
# 35-40 s into the first boot, before S99, so it always exists here. What
# decides instead:
#   - the marker below, which sysupgrade.conf carries across upgrades;
#   - without the marker, a network that has any encryption set was
#     configured by someone (the generated config never has one) and is left
#     as it is.
#
# A fresh install also gets, on its radios (radio_defaults below):
#   - a country (GB) where none is set, and no periodic group key renewal on
#     5 GHz networks. /etc/uci-defaults/95-be7000-country and
#     97-miwrt-5g-group-rekey set the same, and say why; they do it for a
#     router that kept its settings through an update. On a fresh install
#     they run before the radios have started and find nothing to set.
#   - 5 GHz on channel 44 where OpenWrt put it on 36. Both are in the same
#     80 MHz block (36 to 48, at full power without radar checks everywhere),
#     so range and width are the same. But 44 is one of the channels Apple
#     devices meet on for AirDrop, AirPlay and Continuity: while one of those
#     is active, a Mac or an iPhone leaves its network several times a second
#     to listen there, and misses what the router sends meanwhile. With the
#     network itself on 44 it does not have to leave.
# A value that is already set stays.
START=99

MARK=/etc/.be7000_secure_defaults
SSID=OpenWrt-BE7000
# The password is this unit's serial number as printed on its label, without
# the slash: different on every router and not something the radio gives away.
# Only a unit whose serial cannot be read falls back to a shared one.
FALLBACK_KEY=be7000openwrt

default_key() {
	local sn
	sn="$(fw_printenv -n SN 2>/dev/null | tr -cd 'A-Za-z0-9')"
	[ -n "$sn" ] || sn="$(strings "/dev/$(grep '"bdata"' /proc/mtd | cut -d: -f1)ro" 2>/dev/null | sed -n 's/^SN=//p' | head -1 | tr -cd 'A-Za-z0-9')"
	[ "${#sn}" -ge 8 ] && [ "${#sn}" -le 63 ] && { echo "$sn"; return 0; }
	echo "$FALLBACK_KEY"
}

radio_defaults() {
	local r s dev
	for r in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		[ -n "$(uci -q get wireless.$r.country)" ] || uci -q set wireless.$r.country=GB
		[ "$(uci -q get wireless.$r.band)" = 5g ] || continue
		[ "$(uci -q get wireless.$r.channel)" = 36 ] && uci -q set wireless.$r.channel=44
	done
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
		dev="$(uci -q get wireless.$s.device)" || continue
		[ "$(uci -q get wireless.$dev.band)" = 5g ] || continue
		[ -n "$(uci -q get wireless.$s.wpa_group_rekey)" ] || uci -q set wireless.$s.wpa_group_rekey=0
	done
	return 0
}

configured() {
	local r enc
	for r in 0 1; do
		enc="$(uci -q get wireless.default_radio$r.encryption)"
		[ -n "$enc" ] && [ "$enc" != "none" ] && return 0
	done
	return 1
}

boot() {
	[ -e "$MARK" ] && return 0

	(
		i=0
		while [ $i -lt 120 ]; do
			uci -q get wireless.radio0 >/dev/null && uci -q get wireless.radio1 >/dev/null && break
			i=$((i+1)); sleep 1
		done
		if configured; then
			touch "$MARK"
			logger -t be7000-wifi-defaults "wireless already configured, left as is"
			exit 0
		fi
		# the networks stock had, taken by be7000-stock-import on this boot
		if [ -s /etc/be7000-stock-wifi.pending ]; then
			for r in 0 1; do
				uci -q get wireless.radio$r >/dev/null || continue
				uci -q set wireless.radio$r.disabled=0
				uci -q set wireless.default_radio$r.disabled=0
			done
			uci commit wireless
			if /usr/sbin/be7000-stock-import wifi-pending; then
				radio_defaults
				uci commit wireless
				touch "$MARK"
				wifi reload
				exit 0
			fi
		fi
		KEY="$(default_key)"
		for r in 0 1; do
			uci -q get wireless.radio$r >/dev/null || continue
			uci -q set wireless.radio$r.disabled=0
			uci -q set wireless.default_radio$r.disabled=0
			uci -q set wireless.default_radio$r.ssid="$SSID"
			uci -q set wireless.default_radio$r.encryption=psk2
			uci -q set wireless.default_radio$r.key="$KEY"
		done
		radio_defaults
		uci commit wireless
		touch "$MARK"
		if [ "$KEY" = "$FALLBACK_KEY" ]; then
			logger -t be7000-wifi-defaults "fresh install: Wi-Fi $SSID enabled on both bands, serial not readable, shared default password in use: change it"
		else
			logger -t be7000-wifi-defaults "fresh install: Wi-Fi $SSID enabled on both bands, password is the serial number without the slash"
		fi
		wifi reload
	) </dev/null >/dev/null 2>&1 &
}
