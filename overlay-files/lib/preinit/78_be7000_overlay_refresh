#!/bin/sh
# Drop copies of image files from the overlay when the image changes.
#
# The shared settings volume (bigoverlay) outlives every sysupgrade, and over
# time it collects copies of files that belong to the image itself. After an
# upgrade those old copies shadow the new image. This mounts each built-in
# settings volume on its own, before mount_root, and has it cleaned when the
# settings in it last ran with another build: what is moved, what stays and
# how the change is told is in /lib/functions/be7000-image.sh. be7000-romsync
# asks the same question later on.
#
# Old kernel modules are the business of 79_be7000_stale_modules, which looks
# at the kernel alone. A USB disk is not up this early: be7000-extroot cleans
# it on the boot before the router reboots onto it.

if [ -r /lib/functions/be7000-image.sh ]; then
	. /lib/functions/be7000-image.sh
else
	# without the library nothing is known about the image: leave it all alone
	be7000_refresh_volume() { :; }
fi

# the image: preinit runs before the overlay is mounted, so it is /
BE7000_IMAGE_ROOT=""

be7000_overlay_refresh_vol() {
	local dev="$1" mnt=/tmp/be7000-refresh
	mkdir -p "$mnt"
	mount -t ubifs -o noatime "$dev" "$mnt" 2>/dev/null || return 0
	be7000_refresh_volume "$mnt"
	umount "$mnt"
	rmdir "$mnt" 2>/dev/null
}

be7000_overlay_refresh() {
	local n
	for n in /sys/class/ubi/ubi*_*/name; do
		[ -e "$n" ] || continue
		case "$(cat "$n")" in
		rootfs_data|cfg|be7000_storage)
			be7000_overlay_refresh_vol "/dev/$(basename "$(dirname "$n")")"
			;;
		esac
	done
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main be7000_overlay_refresh
