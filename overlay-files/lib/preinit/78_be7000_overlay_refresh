#!/bin/sh
# Drop copies of image files from the overlay when the image changes.
#
# The shared settings volume (bigoverlay) outlives every sysupgrade, and over
# time it collects copies of files that belong to the image itself: rc.d
# links, init scripts, /etc/os-release, /etc/modules.d entries, whole
# packages reinstalled by apk. After an upgrade those old copies shadow the
# new image. An old /etc/modules.d/ath12k without the ath12k_wifi7 module,
# for example, hides the 5 GHz radio completely.
#
# Plain OpenWrt never meets this, because sysupgrade keeps only the
# configuration. So this does the same thing once per image change: every
# file in upper/ that also exists in the image is moved away, unless it is a
# conffile of a package, listed in /etc/sysupgrade.conf or /lib/upgrade/keep.d,
# or one of the always kept places below. Whiteouts (files the user deleted)
# stay. Nothing is deleted: the moved files go to .be7000-replaced/ at the
# root of the volume, replacing the previous batch.
#
# The image changed when the overlay's apk database names another kernel
# than the ROM's; be7000-romsync uses the same test later on.

BE7000_KEEP=/tmp/be7000-refresh.keep

be7000_kernel_of() {
	grep -oE 'kernel=[0-9.]+~[0-9a-f]{32}' "$1" 2>/dev/null | head -1
}

be7000_keep_list() {
	local up="$1"
	{
		cat /lib/apk/packages/*.conffiles "$up"/lib/apk/packages/*.conffiles
		cat /etc/sysupgrade.conf "$up"/etc/sysupgrade.conf
		cat /lib/upgrade/keep.d/* "$up"/lib/upgrade/keep.d/*
	} 2>/dev/null | sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e 's|^/||' -e 's|/$||' | sort -u > "$BE7000_KEEP"
}

# $1 relative path; kept when listed itself or below a listed directory
be7000_is_kept() {
	local p="$1"
	while [ -n "$p" ] && [ "$p" != "." ]; do
		grep -qxF "$p" "$BE7000_KEEP" && return 0
		p=$(dirname "$p")
	done
	return 1
}

# $1 path relative to upper/: true when the image has its own copy and the
# overlay one is not configuration the user keeps across upgrades
be7000_replaced_by_image() {
	case "$1" in
	etc/config/*|etc/apk/*|lib/apk/*|lib/modules/*|lib/modules.stale-*|root/*|\
	etc/dropbear/*|etc/uhttpd.crt|etc/uhttpd.key|etc/shadow|etc/passwd|etc/group|\
	etc/luci-uploads/*|etc/sysupgrade.conf|etc/rc.local|etc/crontabs/*|etc/be7000-reinstall)
		return 1 ;;
	esac
	[ -e "/$1" ] || [ -L "/$1" ] || return 1
	be7000_is_kept "$1" && return 1
	return 0
}

# $1 upper dir, $2 where the moved files go; the image is / (preinit runs
# before the overlay is mounted)
be7000_refresh_upper() {
	local up="$1" stash="$2" f n=0
	[ -d "$up" ] || return 0
	be7000_keep_list "$up"
	rm -rf "$stash"
	(cd "$up" && find . \( -type f -o -type l \)) | sed 's|^\./||' > /tmp/be7000-refresh.files
	while read -r f; do
		be7000_replaced_by_image "$f" || continue
		mkdir -p "$stash/$(dirname "$f")"
		mv "$up/$f" "$stash/$f" && n=$((n + 1))
	done < /tmp/be7000-refresh.files
	rm -f /tmp/be7000-refresh.files "$BE7000_KEEP"
	echo "- be7000: moved $n copies of image files out of $up -" > /dev/kmsg
}

be7000_overlay_refresh_vol() {
	local dev="$1" mnt=/tmp/be7000-refresh rom_k ov_k
	mkdir -p "$mnt"
	mount -t ubifs -o noatime "$dev" "$mnt" 2>/dev/null || return 0
	rom_k=$(be7000_kernel_of /lib/apk/db/installed)
	ov_k=$(be7000_kernel_of "$mnt/upper/lib/apk/db/installed")
	if [ -n "$rom_k" ] && [ -n "$ov_k" ] && [ "$rom_k" != "$ov_k" ]; then
		be7000_refresh_upper "$mnt/upper" "$mnt/.be7000-replaced"
		sync
	fi
	umount "$mnt"
	rmdir "$mnt" 2>/dev/null
}

be7000_overlay_refresh() {
	local n
	for n in /sys/class/ubi/ubi*_*/name; do
		[ -e "$n" ] || continue
		case "$(cat "$n")" in
		rootfs_data|cfg|be7000_storage)
			be7000_overlay_refresh_vol "/dev/$(basename "$(dirname "$n")")"
			;;
		esac
	done
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main be7000_overlay_refresh
