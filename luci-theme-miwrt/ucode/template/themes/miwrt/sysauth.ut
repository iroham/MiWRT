{#
 MiWRT theme for LuCI, sign-in page
 Licensed to the public under the Apache License 2.0.
-#}

{%
	import { getspnam } from 'luci.core';

	const board = ubus.call('system', 'board') ?? {};
	const art = match(board.model ?? '', /AC2100/i) ? 'ac2100' : 'be7000';

	// a router without a password yet: say how to get in (the setup assistant opens after signing in)
	const fresh = getspnam('root')?.pwdp === '';
	const fresh_text = {
		ru: 'Новый роутер: оставьте пароль пустым и нажмите «Войти». Затем откроется мастер настройки.',
		zh_cn: '新路由器：密码留空并点击“登录”，随后将打开设置向导。'
	}[dispatcher.lang] ?? 'New router: leave the password empty and press Log in. The setup assistant opens next.';
-%}

{% include('header', { blank_page: true }) %}

<div class="mw-login">
	<main class="mw-login-pane">
		<form method="post" class="mw-login-form" autocomplete="on">
			<div class="mw-login-brand">
				<img src="{{ media }}/logo.svg" alt="" width="36" height="36">
				<span>MiWRT</span>
			</div>

			<h1>{{ striptags(board.hostname ?? '') }}</h1>
			<p class="mw-login-lede">{{ _('Please enter your username and password.') }}</p>

			{% if (fresh && !fuser): %}
			<div class="alert-message notice" role="status">{{ fresh_text }}</div>
			{% endif %}

			{% if (auth_message): %}
			<div class="alert-message{% if (auth_plugin): %} warning{% endif %}" role="alert">{{ auth_message }}</div>
			{% elif (fuser): %}
			<div class="alert-message error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
			{% endif %}

			<div class="mw-field">
				<label for="luci_username">{{ _('Username') }}</label>
				<input name="luci_username" id="luci_username" type="text" autocomplete="username" autocapitalize="off" spellcheck="false" value="{{ entityencode(duser, true) }}">
			</div>
			<div class="mw-field">
				<label for="luci_password">{{ _('Password') }}</label>
				<input name="luci_password" id="luci_password" type="password" autocomplete="current-password" autofocus>
			</div>

			{% if (auth_fields): %}
				{% for (let field in auth_fields): %}
				<div class="mw-field">
					<label for="{{ field.name }}">{{ _(field.label ?? field.name) }}</label>
					<input
						name="{{ field.name }}"
						id="{{ field.name }}"
						type="{{ field.type ?? 'text' }}"
						{% if (field.placeholder): %}placeholder="{{ field.placeholder }}"{% endif %}
						{% if (field.inputmode): %}inputmode="{{ field.inputmode }}"{% endif %}
						{% if (field.pattern): %}pattern="{{ field.pattern }}"{% endif %}
						{% if (field.maxlength): %}maxlength="{{ field.maxlength }}"{% endif %}
						{% if (field.autocomplete): %}autocomplete="{{ field.autocomplete }}"{% endif %}
						{% if (field.required): %}required{% endif %}
					>
				</div>
				{% endfor %}
			{% endif %}
			{% if (auth_html): %}
				<div class="mw-login-extra">{{ auth_html }}</div>
			{% endif %}
			{% if (auth_assets): %}
				{% for (let asset in auth_assets): %}
					{% if (asset.type == 'script'): %}
						<script src="{{ asset.src }}"></script>
					{% endif %}
				{% endfor %}
			{% endif %}

			<button type="submit" class="btn cbi-button-action important mw-login-submit">{{ _('Log in') }}</button>
		</form>
		{% if (board.model): %}
		<p class="mw-login-foot">{{ striptags(board.model) }}</p>
		{% endif %}
	</main>
	<div class="mw-login-art mw-login-art-{{ art }}" aria-hidden="true"></div>
</div>
<script>
	document.querySelector('.mw-login-form').addEventListener('submit', function() {
		var b = this.querySelector('.mw-login-submit');
		b.classList.add('spinning');
		b.disabled = true;
	});
</script>

{% include('footer', { blank_page: true }) %}
