#!/bin/sh /etc/rc.common
# Tailscale (MiWRT build). Off until option enabled is 1 in /etc/config/tailscale; the MiWRT app and
# web interface switch it (see /usr/share/ucode/miwrt/tailscale.uc). With option via_vpn 1 and the
# MiWRT VPN running, Tailscale reaches its control server and relays through the VPN's local HTTP
# proxy: where Tailscale is blocked, that is how a router signs in at all. Direct connections between
# devices stay outside the proxy.

USE_PROCD=1
START=80

start_service() {
	local enabled port state_file fw_mode via_vpn mem
	config_load tailscale
	config_get_bool enabled settings enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get port settings port 41641
	config_get state_file settings state_file /etc/tailscale/tailscaled.state
	config_get fw_mode settings fw_mode nftables
	config_get_bool via_vpn settings via_vpn 0

	/usr/sbin/tailscaled --cleanup >/dev/null 2>&1

	procd_open_instance
	procd_set_param command /usr/sbin/tailscaled --port "$port" --state "$state_file"
	procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode" TS_NO_LOGS_NO_SUPPORT=true
	if [ "$via_vpn" = 1 ] && /etc/init.d/miwrt-tunnel running >/dev/null 2>&1; then
		procd_append_param env HTTPS_PROXY=http://127.0.0.1:10809 HTTP_PROXY=http://127.0.0.1:10809 NO_PROXY=127.0.0.1,localhost
	fi
	mem=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
	if [ "${mem:-0}" -lt 204800 ]; then
		procd_append_param env GOMEMLIMIT=40MiB GOGC=50
	fi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/tailscaled --cleanup >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger tailscale
}
