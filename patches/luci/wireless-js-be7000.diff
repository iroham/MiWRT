 			}
 			else {
 				dom.content(badge, render_network_badge(radioNet));
@@ -905,7 +923,9 @@
 				this.wifis = [];
 
 				data.forEach(d => {
-					this.wifis.push.apply(this.wifis, d);
+					this.wifis.push.apply(this.wifis, d.filter(function(wifi) {
