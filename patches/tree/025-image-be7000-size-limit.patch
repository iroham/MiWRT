Subject: image: BE7000 size limit that is checked, diagnostic tools out

The firmware slot is 40 MiB of NAND: 320 blocks of 128 KiB, of which UBI
keeps 20 for bad blocks and 4 for itself. The 296 left hold the kernel,
the system and, in what remains, the in-slot settings volume
(rootfs_data). With the settings on the data partition that volume only
carries the pointer to them, but it is the whole settings space of a
router that keeps bigoverlay off, and the fallback when the data
partition does not mount.

IMAGE_SIZE was never compared with anything: the recipe ran check-size
only when NAND_SIZE was set, and it is not. An image that outgrew the
slot would have been found by the router, at the moment it writes the
update. The recipe now checks the finished UBI image against IMAGE_SIZE,
and IMAGE_SIZE is 273 blocks: two for the volume table and 271 for kernel
and system, which leaves at least 25 blocks (3 MiB) for rootfs_data.

iperf3 leaves the image and ethtool-full gives way to the plain ethtool
(the boot log uses "ethtool", "ethtool -a" and "ethtool -S", which the
plain one has). Both stay available as packages.

--- a/target/linux/qualcommbe/image/ipq95xx.mk
+++ b/target/linux/qualcommbe/image/ipq95xx.mk
@@ -36,8 +36,7 @@ define Build/be7000-append-ubi
 		$@.ubinize.cfg
 	cat $@.tmp >> $@
 	rm -f $@.tmp $@.ubinize.cfg
-	$(if $(and $(IMAGE_SIZE),$(NAND_SIZE)),\
-		$(call Build/check-size,$(UBI_NAND_SIZE_LIMIT)))
+	$(call Build/check-size)
 endef
 
 define Device/8devices_kiwi-dvk
@@ -93,13 +92,13 @@ define Device/xiaomi_be7000
 	PAGESIZE := 2048
 	SOC := ipq9574
 	KERNEL_SIZE := 6096k
-	IMAGE_SIZE := 32116k
+	IMAGE_SIZE := 34944k
 	DEVICE_PACKAGES := ath11k-firmware-ipq9574 \
 					kmod-ath11k-ahb kmod-ath12k ath12k-firmware-qcn9274 \
 					kmod-qrtr-smd \
 					kmod-usb-storage be7000-nfc-i2ctransfer \
 					luci luci-app-be7000-nfc luci-proto-wireguard \
-					iperf3 ethtool-full mdio-tools qrencode uboot-envtools \
+					ethtool mdio-tools qrencode uboot-envtools \
 					kmod-wireguard wireguard-tools
 	IMAGE/factory.ubi := be7000-append-ubi
 endef
