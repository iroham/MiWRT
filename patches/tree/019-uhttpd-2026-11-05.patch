 	append_arg "$cfg" error_page "-E"
 	append_arg "$cfg" max_requests "-n" 3
+	append_arg "$cfg" max_requests_per_source "-W"
 	append_arg "$cfg" max_connections "-N"
 
 	append_bool "$cfg" no_ubusauth "-a" 0
@@ -269,6 +276,18 @@ get_interface_by_ip()
 	config_foreach resolve_iface interface "$@"
 }
 
+uhttpd_vrf_trigger()
+{
+	local cfg="$1"
+	local vrf
+
+	# An instance in a VRF is not started at boot. If no listen address
+	# points to an interface, no interface trigger would start it later,
+	# so any interface coming up starts it.
+	config_get vrf "$cfg" vrf
+	[ -n "$vrf" ] && [ -z "$(uhttpd_interfaces "$cfg")" ] && all=1
+}
+
 service_triggers()
 {
 	local iface ifaces all=0
@@ -278,7 +297,8 @@ service_triggers()
 
 	config_load uhttpd
 	ips="$(config_foreach uhttpd_interfaces uhttpd)"
-	[ -z "$ips" ] && return 0
+	config_foreach uhttpd_vrf_trigger uhttpd
+	[ -z "$ips" ] && [ "$all" = 0 ] && return 0
 
 	for ip in $ips; do
 		iface="$(get_interface_by_ip $ip)"
@@ -295,6 +315,11 @@ service_triggers()
 	fi
 }
 
+boot() {
+	BOOT=1
+	start "$@"
+}
+
 start_service() {
 	config_load uhttpd
 	config_foreach start_instance uhttpd
